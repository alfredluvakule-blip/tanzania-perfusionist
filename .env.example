# Copy to .env.local (or add in Vercel: Settings > Environment Variables)

# Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: your custom domain, e.g. https://www.example.org (defaults to the Vercel production domain)
NEXT_PUBLIC_SITE_URL=

# Optional: Google Search Console verification code (HTML tag method, the content="..." value)
GOOGLE_SITE_VERIFICATION=
